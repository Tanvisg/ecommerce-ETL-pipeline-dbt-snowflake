[0m01:49:02.104697 [debug] [Thread-1 (]: On model.hmart.mart_revenue_breakdown: /* {"app": "dbt", "dbt_version": "1.12.5", "profile_name": "hmart", "target_name": "dev", "node_id": "model.hmart.mart_revenue_breakdown"} */
create or replace   view HMART.DEV.mart_revenue_breakdown
  
   as (
    SELECT
    DATE_TRUNC('month', f.order_ts)::DATE AS month_start,
    p.category,
    f.channel,
    c.country,
    c.region,

    COUNT(DISTINCT f.order_id) AS orders,
    SUM(f.quantity) AS units,
    ROUND(SUM(f.net_amount), 2) AS net_revenue,
    ROUND(SUM(f.gross_margin), 2) AS gross_margin

FROM HMART.DEV.fct_sales f

JOIN HMART.DEV.dim_products p
    ON p.product_id = f.product_id

JOIN HMART.DEV.dim_customers c
    ON c.customer_id = f.customer_id

WHERE f.is_revenue

GROUP BY 1, 2, 3, 4, 5
  );
