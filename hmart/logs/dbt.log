create or replace transient table HMART.DEV.dim_customers
         as
        (-- WITH src_customers AS (
--     SELECT * FROM HMART.DEV.src_customers
-- )

-- SELECT 
--     customer_id,
--     customer_name,
--     email,
--     phone,
--     country,
--     city,
--     gender,
--     birth_date,
--     signup_date,
--     loyalty_tier,
--     is_active,
-- FROM src_customers
with base as (
    select *, date_diff('year', birth_date, date '2026-09-21') as age_years
    from stg_customers
)
select
    email, phone, country, city,
    case country
        when 'India' then 'South Asia'     when 'UAE' then 'Middle East'
        when 'USA' then 'North America'    when 'Canada' then 'North America'
        when 'Brazil' then 'Latin America' when 'Japan' then 'Asia Pacific'
        when 'Australia' then 'Asia Pacific' else 'Europe'
    end as region,
    gender, birth_date, age_years,
    case when age_years is null then 'Unknown'
         when age_years < 25 then '18-24' when age_years < 35 then '25-34'
         when age_years < 45 then '35-44' when age_years < 55 then '45-54'
         when age_years < 65 then '55-64' else '65+' end as age_band,
    signup_date,
    date_diff('day', signup_date, date '2026-09-21') as tenure_days,
    loyalty_tier, is_active
from base;
