    SUM(net_amount) AS net_amount,
    SUM(cost_amount) AS cost_amount,
    SUM(gross_margin) AS gross_margin,

    MAX(is_revenue) AS is_revenue

FROM HMART.DEV.fct_sales

GROUP BY order_id
        );
